# =====================================================================
# NavDrishti AI Environment Configuration
# =====================================================================

# Server & Map Tile Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/live
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Modes: DEMO, REPLAY, LIVE
ENABLE_DEMO_MODE=true
ENABLE_REPLAY_MODE=true
ENABLE_LIVE_MODE=false

# Official Meteorological Provider Connectors (Server-side proxy only)
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
MOSDAC_API_BASE_URL=https://mosdac.gov.in/api
LIGHTNING_API_BASE_URL=
NWP_API_BASE_URL=

# Databases & Infrastructure
DATABASE_URL=postgresql://navdrishti:secure_password@localhost:5432/navdrishti_gis
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_URL=http://localhost:9000
MODEL_SERVICE_URL=http://localhost:8501

# System Settings
DEFAULT_REGION=Maharashtra
LOG_LEVEL=INFO
